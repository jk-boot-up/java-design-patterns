[
  {
    "op": "add",
    "path": "/spec/template/spec/volumes",
    "value": [{"name": "sidecar-config", "configMap": {"name": "sidecar-config"}}]
  },
  {
    "op": "add",
    "path": "/spec/template/spec/initContainers",
    "value": [{
      "name": "sidecar",
      "image": "nginx:1.31.5-alpine",
      "imagePullPolicy": "Never",
      "restartPolicy": "Always",
      "env": [{"name": "SERVICE_NAME", "value": "refunds"}, {"name": "NGINX_ENVSUBST_FILTER", "value": "SERVICE_NAME"}],
      "volumeMounts": [{"name": "sidecar-config", "mountPath": "/etc/nginx/templates/default.conf.template", "subPath": "default.conf.template"}],
      "startupProbe": {"httpGet": {"path": "/healthz", "port": 8081}, "periodSeconds": 1}
    }]
  }
]
