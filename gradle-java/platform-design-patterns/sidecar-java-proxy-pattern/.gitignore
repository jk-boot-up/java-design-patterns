/sidecar-java-proxy-pattern.iml
/build/
/.gradle/
/.idea/

# Video build output. Everything under video/ except the scripts is
# generated by video/build_video.sh, so none of it is committed.
/video/build/
/video/*.mp4
/video/*.m4a
/video/*.srt
__pycache__/

# Tier 2 build output. `real/` is its own Gradle build with its own
# subprojects, and demo.sh generates a self-signed certificate and a captured
# transcript under real/build/. None of it is committed; the source, the nginx
# config, the compose file and the README are.
/real/build/
/real/*/build/
/real/.gradle/
