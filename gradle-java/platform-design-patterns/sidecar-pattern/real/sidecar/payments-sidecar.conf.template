# The sidecar. One file, mounted into every proxy in the shop.
#
# This is the most important file in the project. Everything Tier 1 argues in
# Java is written down here in twenty-odd lines of somebody else's language,
# and the argument is this: none of it is about checkout, or refunds, or what
# the shop sells. It is how anything on this network talks to that supplier.
# Change it once and every service changes, because there is one copy and both
# containers mount it.
#
# It is a *template* rather than a plain config because the two proxies differ
# by exactly one thing -- the name they report to the provider -- and the nginx
# image will run `envsubst` over anything in /etc/nginx/templates before it
# starts. NGINX_ENVSUBST_FILTER in the compose file restricts that substitution
# to SERVICE_NAME: without it, envsubst would also eat $host, $remote_addr and
# every other nginx runtime variable below, and nginx would start with an empty
# log format and no idea who it is proxying for.

upstream provider {
    # The same address three times, on purpose, and this is the first thing
    # that surprises people about retrying in nginx.
    #
    # `proxy_next_upstream` moves to the *next server in the group*. With one
    # entry there is no next one, and nginx will never retry however high you
    # set the tries. Three entries is how "up to three attempts" is spelled
    # when the upstream is a single address.
    #
    # max_fails=0 turns off nginx's own health counting. Without it a couple of
    # declines would mark the provider down for a while and the next payment
    # would fail before it left the machine -- a circuit breaker nobody asked
    # for, arriving as a side effect.
    server gateway:9443 max_fails=0;
    server gateway:9443 max_fails=0;
    server gateway:9443 max_fails=0;
}

# The counters, named once for everybody. In Tier 1 this is the concern four
# teams each invented their own names for; here every service in the shop logs
# the same fields in the same order, because there is one log_format.
log_format attempts '${SERVICE_NAME}  $upstream_addr  status=$upstream_status  '
                    'took=$upstream_response_time  total=$request_time';

server {
    listen 8081;
    access_log /var/log/nginx/attempts.log attempts;

    location /pay {
        proxy_pass https://provider;

        # ---- concern 1: how many times to try -------------------------------
        #
        # `non_idempotent` is required and is worth understanding rather than
        # copying. nginx will not retry a POST unless you say so, because a
        # POST that timed out may well have been processed. Saying it here is
        # a statement that the provider treats a repeated reference as one
        # charge -- which is the same idempotency-key promise the Idempotent
        # Consumer pattern is about, and it is a promise, not a default.
        #
        # http_503 and nothing else. A 429 is the account's allowance being
        # spent, and retrying a refusal is precisely how one service's stale
        # policy takes down every other service's payments.
        proxy_next_upstream error timeout http_503 non_idempotent;
        proxy_next_upstream_tries 3;

        # ---- concern 2: when to give up -------------------------------------
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
        proxy_next_upstream_timeout 5s;

        # ---- concern 3: what to present on the wire -------------------------
        #
        # The service behind this proxy has no keystore, no trust store and no
        # protocol list. It spoke plain HTTP to localhost. This is where the
        # shop's side of the transport contract lives.
        #
        # verify is off because the provider in this demo holds a certificate
        # generated by demo.sh five seconds earlier and signed by nobody. In
        # production this is where `proxy_ssl_verify on` and a CA bundle go --
        # and the point stands either way: it goes *here*, once.
        proxy_ssl_protocols TLSv1.3;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;

        # ---- concern 4: who is calling --------------------------------------
        proxy_set_header X-Service ${SERVICE_NAME};
        proxy_set_header Host gateway;
    }

    location /healthz {
        return 200 "${SERVICE_NAME} sidecar up\n";
    }
}
